<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.05" />
    <xacro:property name="lidar_height" value="0.03" />

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.15" r="${lidar_radius}" l="${lidar_height}"
                        o_xyz="0 0 ${lidar_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="${(-0.2 + base_length + lidar_height) / 2.0} 0 ${base_height}"
        rpy="0 0 0"/>
    </joint>

<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <always_on>true</always_on>
    <visualize>true</visualize>
    <update_rate>15</update_rate>
    <topic>scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>

    <ray>
  <scan>
    <horizontal>
      <samples>720</samples>
      <resolution>1</resolution>
      <min_angle>-3.14159</min_angle>
      <max_angle>3.14159</max_angle>
    </horizontal>
  </scan>

  <range>
    <min>0.10</min>
    <max>10.0</max>
    <resolution>0.01</resolution>
  </range>

  <noise>
    <type>gaussian</type>
    <mean>0.0</mean>
    <stddev>0.01</stddev>
  </noise>
</ray>
  </sensor>
</gazebo>
</robot>